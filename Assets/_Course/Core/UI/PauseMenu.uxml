<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Course/Core/UI/CourseTheme.uss" />
    <ui:VisualElement name="pause-menu" class="screen screen--overlay">
        <ui:VisualElement class="panel">
            <ui:Label name="title-label" text="Paused" class="title" />
            <ui:Button name="resume-button" text="Resume" class="menu-button" />
            <ui:Button name="settings-button" text="Settings" class="menu-button" />
            <ui:Button name="restart-button" text="Restart" class="menu-button" />
            <ui:Button name="menu-button" text="Main Menu" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
