<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Course/Core/UI/CourseTheme.uss" />
    <ui:VisualElement name="settings" class="screen screen--overlay">
        <ui:VisualElement class="panel">
            <ui:Label name="title-label" text="Settings" class="title" />
            <ui:Slider name="music-slider" label="Music" low-value="0" high-value="1" value="0.8" class="settings-row" />
            <ui:Slider name="effects-slider" label="Sound Effects" low-value="0" high-value="1" value="1" class="settings-row" />
            <ui:Toggle name="fullscreen-toggle" label="Full Screen" class="settings-row" />
            <ui:Button name="back-button" text="Back" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
