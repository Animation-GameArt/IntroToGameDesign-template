<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Course/Core/UI/CourseTheme.uss" />
    <Style src="/Assets/_Course/Kits/VisualNovel/UI/VisualNovelUI.uss" />
    <ui:VisualElement name="vn-root" class="vn-root" picking-mode="Ignore">
        <ui:VisualElement name="background" class="vn-background" picking-mode="Ignore" />
        <ui:VisualElement name="character-left" class="vn-character vn-character--left" picking-mode="Ignore" />
        <ui:VisualElement name="character-center" class="vn-character vn-character--center" picking-mode="Ignore" />
        <ui:VisualElement name="character-right" class="vn-character vn-character--right" picking-mode="Ignore" />
        <ui:VisualElement name="meters" class="vn-meters" picking-mode="Ignore" />
        <ui:VisualElement name="choices" class="vn-choices" />
        <ui:VisualElement name="dialogue-panel" class="vn-dialogue">
            <ui:Label name="speaker-label" text="Name" class="vn-speaker" picking-mode="Ignore" />
            <ui:Label name="line-label" text="The line of dialogue goes here." class="vn-line" picking-mode="Ignore" />
            <ui:Label name="continue-mark" text="Next &gt;" class="vn-continue" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
