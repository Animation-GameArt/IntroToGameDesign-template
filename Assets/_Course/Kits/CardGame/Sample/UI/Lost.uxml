<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Course/Core/UI/CourseTheme.uss" />
    <ui:VisualElement name="game-over" class="screen screen--overlay">
        <ui:VisualElement class="panel">
            <ui:Label name="title-label" text="Game Over" class="title" />
            <ui:Label name="score-label" text="" class="subtitle" />
            <ui:Button name="try-again-button" text="Try Again" class="menu-button" />
            <ui:Button name="menu-button" text="Main Menu" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
