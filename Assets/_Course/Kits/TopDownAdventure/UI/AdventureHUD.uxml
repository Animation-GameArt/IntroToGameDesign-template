<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Course/Core/UI/CourseTheme.uss" />
    <Style src="/Assets/_Course/Kits/TopDownAdventure/UI/AdventureHUD.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="hearts" class="hearts" picking-mode="Ignore" />
        <ui:Label name="keys-label" text="Keys: 0" class="hud-label" picking-mode="Ignore" />
        <ui:Label name="coins-label" text="Coins: 0" class="hud-label" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement name="message-box" class="message-box" picking-mode="Ignore">
        <ui:Label name="message-label" text="" class="message-text" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
