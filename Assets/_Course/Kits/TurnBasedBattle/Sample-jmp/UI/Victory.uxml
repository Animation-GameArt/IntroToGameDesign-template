<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="/Assets/_Course/Core/UI/CourseTheme.uss" />
    <ui:VisualElement name="level-complete" class="screen screen--overlay">
        <ui:VisualElement class="panel">
            <ui:Label name="title-label" text="Victory!" class="title" />
            <ui:Label name="coins-label" text="Coins: 0" class="subtitle" />
            <ui:Button name="next-button" text="Next Level" class="menu-button" />
            <ui:Button name="menu-button" text="Main Menu" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
